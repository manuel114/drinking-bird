# Both tokens come from the Slack app you create from slack-manifest.json.
# App-level token (Basic Information -> App-Level Tokens, scope connections:write)
SLACK_APP_TOKEN=xapp-...
# User token (OAuth & Permissions -> User OAuth Token). The bird posts as you.
SLACK_USER_TOKEN=xoxp-...

# "agent" asks your coding agent for a plausible reply. "y" just presses Y.
DRINKING_BIRD_MODE=agent

# Which coding agent writes the replies: "claude", "codex", or any shell
# command that reads a prompt on stdin and prints the reply on stdout.
# Leave empty to use the first of claude / codex found on your PATH.
DRINKING_BIRD_AGENT=

# Optional: how you write, so the bird sounds like you.
# DRINKING_BIRD_STYLE=lowercase, no full stops, says "cheers" a lot

# Seconds to wait before replying (min-max). Nobody answers in 200ms.
DRINKING_BIRD_DELAY=25-90

# Replies per conversation per hour before the bird falls over and goes quiet.
DRINKING_BIRD_MAX_REPLIES=3

# The bird clocks off after this many hours.
DRINKING_BIRD_HOURS=8
