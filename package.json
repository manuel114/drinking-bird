{
  "name": "drinking-bird",
  "version": "0.1.0",
  "description": "Covers your Slack on GTA VI launch day. A drinking bird that presses Y so you don't have to.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
