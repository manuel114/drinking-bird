    "test": "tsx --test test/*.test.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@slack/web-api": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
